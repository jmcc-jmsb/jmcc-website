# ABOUTME: Apache config for the deployed site — canonical host, legacy redirects, headers, caching.
# ABOUTME: Every redirect is single-hop by design; see tests/check-redirects.ps1 for the assertions.
#
# DIVISION OF LABOUR — both halves are required, neither covers the other:
#   CASA IT (Ryan): domain-to-server routing and SSL. Points wecompete.ca and
#     jmccjmsb.ca at this document root.
#   This file: path-to-path rewriting and the canonical host, on whichever domain
#     the request lands. If jmccjmsb.ca reaches this server directly, the canonical
#     rule below sends it to www.wecompete.ca in one hop.
#
# ⚠ This file only takes effect if AllowOverride permits it. Confirm with Ryan that
#   .htaccess overrides are enabled — if they are not, all of this must move into the
#   vhost config instead. See docs/hosting-questions.md.

# ---------------------------------------------------------------------------
# 1. Canonical host and HTTPS
# ---------------------------------------------------------------------------
# Two rules, not three, so nothing ever chains: rule A fixes scheme AND host in a
# single hop; rule B only has to handle scheme once the host is already right.

RewriteEngine On

# A — any non-canonical host (apex, jmccjmsb.ca, raw IP, cPanel temp URL) goes
# straight to the canonical origin, carrying its path. Staging is exempt, or it
# would redirect itself into production.
RewriteCond %{HTTP_HOST} !^www\.wecompete\.ca$ [NC]
RewriteCond %{HTTP_HOST} !^staging\. [NC]
RewriteRule ^ https://www.wecompete.ca%{REQUEST_URI} [R=301,L]

# B — right host, wrong scheme. The X-Forwarded-Proto check matters: behind a
# TLS-terminating proxy %{HTTPS} reads "off" on an already-secure request, and
# without this condition that becomes an infinite redirect loop.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 2. Legacy Wix paths
# ---------------------------------------------------------------------------
# All mod_rewrite, deliberately — mixing `Redirect` (mod_alias) with RewriteRule
# in one file makes ordering unpredictable and can produce a second hop.
# Longer paths first so a prefix never shadows a more specific rule.
#
# Every target ends in a slash. The build emits directories (dist/competitions/index.html),
# so a slashless target makes mod_dir issue its own 301 to add the slash — a second hop on
# every legacy link. The slash is also the canonical form in the sitemap.

RewriteRule ^copy-of-nationals-internationals/?$   /sponsors/      [R=301,L]
RewriteRule ^nationals-internationals/?$           /competitions/  [R=301,L]
RewriteRule ^nationals/?$                          /competitions/  [R=301,L]
RewriteRule ^regionals/?$                          /competitions/  [R=301,L]
RewriteRule ^about-3/?$                            /donate/        [R=301,L]
RewriteRule ^our-team/?$                           /team/          [R=301,L]
RewriteRule ^incident-form/?$                      /report/        [R=301,L]
RewriteRule ^copy-of-hm-delegates/?$               /portal/        [R=301,L]
RewriteRule ^hm-delegates/?$                       /portal/        [R=301,L]
RewriteRule ^jdc-delegates/?$                      /portal/        [R=301,L]
RewriteRule ^jdcc-delegates/?$                     /portal/        [R=301,L]
RewriteRule ^hr-sympo-delegates/?$                 /portal/        [R=301,L]

# Linked from an archived blog post; the old Wix page is gone, recruitment lives here now.
RewriteRule ^comm299-recruitment/?$                /get-involved/  [R=301,L]

# ---------------------------------------------------------------------------
# 3. Old blog URLs → the hidden blog (preserved for revival)
# ---------------------------------------------------------------------------

# Post #7 was published with an accented slug. Apache decodes %C3%A9 before matching,
# so both the literal and percent-encoded forms arrive here as UTF-8 bytes — match
# them explicitly and send both to the ASCII slug. Must precede the generic rule.
RewriteRule "^post/from-montr\xc3\xa9al-to-melbourne-how-you-can-go-global-with-jmcc/?$" /blog/from-montreal-to-melbourne-how-you-can-go-global-with-jmcc/ [R=301,L,NE]
RewriteRule "^post/from-montr(&eacute;|%C3%A9)al-to-melbourne-how-you-can-go-global-with-jmcc/?$" /blog/from-montreal-to-melbourne-how-you-can-go-global-with-jmcc/ [R=301,L,NE]

# Wix paginated the blog index; there is only one page now.
RewriteRule ^blog/page/[0-9]+/?$ /blog/ [R=301,L]

# Every other archived post keeps its old slug verbatim. The slug is captured without its
# trailing slash, then given exactly one back, so /post/x and /post/x/ both land on /blog/x/.
RewriteRule ^post/(.+?)/?$ /blog/$1/ [R=301,L]

# ---------------------------------------------------------------------------
# 4. Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

    # Staging must never be indexed. Scoped by host prefix - the same ^staging. test the
    # canonical rule at the top of this file uses - so one build artifact deploys
    # unchanged to both environments and nothing environment-specific lives in the build.
    #
    # Deliberately a header and not a build flag: an env-var-driven noindex would leave
    # the live site one wrong artifact away from being deindexed, on a green deploy with
    # nothing visibly broken to notice it by. This rule can only ever match a staging.* host.
    #
    # robots.txt is deliberately NOT swapped for staging. A crawler has to be able to fetch
    # a page to see this header, so disallowing would leave staging URLs eligible as bare
    # links with no snippet - the same reasoning written up in public/robots.txt.
    <If "%{HTTP_HOST} =~ /^staging\./">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>

    # frame-src must allow docs.google.com or the /report incident form embed is
    # blocked outright and the page shows an empty box.
    #
    # 'unsafe-inline' on script-src is required by Astro's inline bootstrap and
    # view-transition scripts. Removing it needs per-request nonces, which needs
    # SSR — this is a static build, so it is not available. Upgrade path: move to
    # nonces if the site ever gains an SSR adapter.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://docs.google.com https://www.google.com; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # HSTS is deliberately NOT set yet. Turn it on only after SSL is confirmed
    # working on wecompete.ca AND jmccjmsb.ca — a premature max-age locks visitors
    # out of any domain whose certificate is not ready.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# 5. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    # Already-compressed formats gain nothing and cost CPU.
    SetEnvIfNoCase Request_URI \.(?:jpe?g|png|webp|avif|gif|mp4|woff2?)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------------
# 6. Caching
# ---------------------------------------------------------------------------
# Astro fingerprints everything in /_astro/, so those are safe to cache forever.
# HTML must revalidate or a deploy is invisible to returning visitors.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|xml)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# ---------------------------------------------------------------------------
# 7. Errors
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# 8. Hardening
# ---------------------------------------------------------------------------
# The form state directory lives outside the document root, but block dotfiles
# and the local PHP override anyway in case anything is ever misplaced.
# php.ini is cPanel's and stays in the document root (deploy.yml excludes it), so it
# is denied here; error_log is PHP's fallback log name if section 9 is ever lost.
<FilesMatch "^\.|^config\.local\.php$|^php\.ini$|^error_log$">
    Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off

# ---------------------------------------------------------------------------
# 9. PHP error log
# ---------------------------------------------------------------------------
# Copied verbatim from the block cPanel's MultiPHP INI Editor wrote into the server's
# own .htaccess, which every deploy replaces with this file. Without it PHP logs to an
# `error_log` file beside the script, inside the document root and wiped on each deploy.
# If anyone changes settings in the INI Editor, copy its new block here as well, or the
# next deploy reverts it. The same settings live in cPanel's php.ini for handlers that
# ignore .htaccess; deploy.yml excludes that file so rsync --delete leaves it alone.
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/jmccjmsb/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/jmccjmsb/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit
