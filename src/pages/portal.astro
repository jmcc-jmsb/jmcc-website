---
// ABOUTME: Delegate Portal (EN; /fr imports this) — polished work-in-progress screen, noindexed (Phase 2 §9).
// ABOUTME: All visual content lives in PortalPlaceholder.astro so a future mock-up swaps in one place.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PortalPlaceholder from '../components/PortalPlaceholder.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const title = lang === 'fr' ? 'Portail des délégués — JMCC' : 'Delegate Portal — JMCC';
---

<BaseLayout title={title} noIndex={true}>
  <Nav />
  <main>
    <PortalPlaceholder />
  </main>
  <Footer />
</BaseLayout>
