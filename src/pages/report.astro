---
// ABOUTME: Incident Form (EN; /fr imports this) — calm layout, anonymous-friendly: all identity
// ABOUTME: fields optional; routes to the VP Internal via the Phase 4 handler (Phase 2 §13).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    title: 'Report an Incident — JMCC',
    description:
      'Report an incident or code-of-conduct concern within JMCC. Anonymous submissions are fully supported.',
    heroTitle: 'Report an Incident',
    intro:
      'This form is for reporting incidents, concerns, or code-of-conduct violations within JMCC. Submissions go directly to the VP Internal and are treated confidentially.',
    anonNote:
      'You may submit completely anonymously — every identity field below is optional.',
    formName: 'Name (optional)',
    formEmail: 'Email (optional — only if you would like a follow-up)',
    formDate: 'Date of incident (optional)',
    formDescription: 'What happened?',
    formSubmit: 'Submit Report',
    success:
      'Your report has been submitted. Thank you for speaking up — it will be reviewed confidentially by the VP Internal.',
  },
  fr: {
    title: 'Signaler un incident — JMCC',
    description:
      'Signalez un incident ou un manquement au code de conduite au sein du JMCC. Les soumissions anonymes sont pleinement acceptées.',
    heroTitle: 'Signaler un incident',
    intro:
      'Ce formulaire sert à signaler des incidents, des préoccupations ou des manquements au code de conduite au sein du JMCC. Les soumissions sont transmises directement au ou à la VP Interne et traitées confidentiellement.',
    anonNote:
      'Vous pouvez soumettre de façon totalement anonyme — tous les champs d’identité ci-dessous sont facultatifs.',
    formName: 'Nom (facultatif)',
    formEmail: 'Courriel (facultatif — seulement si vous souhaitez un suivi)',
    formDate: 'Date de l’incident (facultatif)',
    formDescription: 'Que s’est-il passé ?',
    formSubmit: 'Soumettre',
    success:
      'Votre signalement a été soumis. Merci de vous être exprimé — il sera examiné confidentiellement par le ou la VP Interne.',
  },
}[lang];

const inputCls =
  'w-full bg-white border border-border/30 px-4 py-3 font-montserrat text-sm text-ink focus:outline-none focus:border-primary transition-colors';
const labelCls = 'block font-montserrat text-xs font-semibold text-ink uppercase tracking-widest mb-2';
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main>
    <!-- Calm, cream-first layout — no maroon-heavy styling (§13) -->
    <section class="bg-cream py-20 px-6">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-unbounded font-bold text-3xl md:text-4xl text-ink leading-tight mb-6">
          {copy.heroTitle}
        </h1>
        <p class="font-montserrat text-ink/80 leading-relaxed mb-4">{copy.intro}</p>
        <p class="font-montserrat text-sm font-semibold text-primary mb-12">{copy.anonNote}</p>

        <p
          id="form-success"
          class="hidden bg-white border border-primary text-primary font-montserrat text-sm p-5 mb-8"
          role="status"
        >
          {copy.success}
        </p>

        <!-- Handler built in Phase 4 — endpoint agreed as /api/report.php; routes to the VP Internal
             (name/email in contact.json, currently TODO — never hardcoded here). -->
        <form id="report-form" action="/api/report.php" method="POST" class="space-y-6">
          <div>
            <label for="name" class={labelCls}>{copy.formName}</label>
            <input type="text" id="name" name="name" class={inputCls} />
          </div>
          <div>
            <label for="email" class={labelCls}>{copy.formEmail}</label>
            <input type="email" id="email" name="email" class={inputCls} />
          </div>
          <div>
            <label for="incident-date" class={labelCls}>{copy.formDate}</label>
            <input type="date" id="incident-date" name="incident_date" class={inputCls} />
          </div>
          <div>
            <label for="description" class={labelCls}>{copy.formDescription}</label>
            <textarea id="description" name="description" rows="8" required class={inputCls}></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center px-6 py-3 font-montserrat font-semibold text-sm tracking-widest uppercase bg-primary text-cream border border-primary hover:bg-border hover:border-border transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2"
          >
            {copy.formSubmit}
          </button>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    function initReportConfirmation() {
      if (new URLSearchParams(window.location.search).has('submitted')) {
        document.getElementById('form-success')?.classList.remove('hidden');
        document.getElementById('report-form')?.classList.add('hidden');
      }
    }
    document.addEventListener('astro:page-load', initReportConfirmation);
  </script>
</BaseLayout>
