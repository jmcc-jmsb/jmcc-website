---
// ABOUTME: Incident report (EN; /fr imports this) — shell around an embedded Google Form (Phase 4B).
// ABOUTME: No backend. Embed URL and the anonymity claim both come from site.json, never hardcoded.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
import site from '../data/site.json';
import contact from '../data/contact.json';

const lang = getLangFromUrl(Astro.url);

const embedUrl = site.incidentFormUrl?.[lang] ?? '';
const formReady = Boolean(embedUrl && !embedUrl.startsWith('TODO'));

// The anonymity claim is gated on a flag that is only set after someone checks the
// Form's own settings. Claiming anonymity the Form does not actually provide would
// be worse than saying nothing — so null means say nothing.
const isAnonymous = site.incidentFormAnonymous === true;

const vpEmail = contact.vpInternal?.email ?? '';
const hasVpEmail = Boolean(vpEmail && !vpEmail.startsWith('TODO'));
const fallbackEmail = hasVpEmail ? vpEmail : contact.email;

// Strip the embed parameter for the "open in a new tab" link — the embedded view is
// chrome-less and looks broken as a standalone page.
const standaloneUrl = formReady ? embedUrl.replace(/([?&])embedded=true&?/, '$1').replace(/[?&]$/, '') : '';

const copy = {
  en: {
    title: 'Report an Incident — JMCC',
    description:
      'Report an incident or code-of-conduct concern within JMCC. Submissions are reviewed confidentially by the VP Internal.',
    heroTitle: 'Report an Incident',
    intro:
      'This form is for reporting incidents, concerns, or code-of-conduct violations within JMCC. Submissions are received and reviewed confidentially by the VP Internal.',
    anonNote: 'You may submit this form anonymously. You will not be asked to sign in.',
    privacy:
      'This form is hosted by Google. Loading it shares your IP address with Google and may set third-party cookies.',
    iframeTitle: 'JMCC incident report form',
    openTab: 'Open the form in a new tab',
    blocked: 'If the form does not appear, your browser may be blocking it.',
    pendingTitle: 'The form is being set up',
    pendingBody: 'The incident report form is not available yet. In the meantime, you can reach the VP Internal directly:',
    loading: 'Loading the form…',
  },
  fr: {
    title: 'Signaler un incident — JMCC',
    description:
      'Signalez un incident ou un manquement au code de conduite au sein du JMCC. Les signalements sont examinés confidentiellement par la VP Interne.',
    heroTitle: 'Signaler un incident',
    intro:
      'Ce formulaire sert à signaler des incidents, des préoccupations ou des manquements au code de conduite au sein du JMCC. Les signalements sont reçus et examinés confidentiellement par la VP Interne.',
    anonNote: 'Vous pouvez soumettre ce formulaire de façon anonyme. Aucune connexion ne vous sera demandée.',
    privacy:
      'Ce formulaire est hébergé par Google. Son chargement transmet votre adresse IP à Google et peut déposer des témoins tiers.',
    iframeTitle: 'Formulaire de signalement d’incident du JMCC',
    openTab: 'Ouvrir le formulaire dans un nouvel onglet',
    blocked: 'Si le formulaire n’apparaît pas, votre navigateur le bloque peut-être.',
    pendingTitle: 'Le formulaire est en préparation',
    pendingBody: 'Le formulaire de signalement n’est pas encore disponible. Entre-temps, vous pouvez joindre la VP Interne directement :',
    loading: 'Chargement du formulaire…',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description} noIndex={true}>
  <Nav />
  <main>
    <!-- Calm, cream-first layout — no maroon-heavy styling (§13) -->
    <section class="bg-cream py-20 px-6">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-unbounded font-bold text-3xl md:text-4xl text-ink leading-tight mb-6">
          {copy.heroTitle}
        </h1>
        <p class="font-montserrat text-ink/80 leading-relaxed mb-4">{copy.intro}</p>
        {isAnonymous && (
          <p class="font-montserrat text-sm font-semibold text-primary mb-4">{copy.anonNote}</p>
        )}

        {formReady ? (
          <>
            <p class="font-montserrat text-xs text-muted leading-relaxed mb-8">{copy.privacy}</p>

            <!-- A cross-origin iframe cannot resize itself, so the height is fixed per
                 breakpoint. Measured against the live form: 3585px at the mobile iframe
                 width (325px), 2810px at the desktop one (670px) — Google stacks the fields
                 below ~768px. Values carry ~100px of slack for inline validation errors.
                 Sized to overshoot deliberately: trailing whitespace is a better failure
                 than a nested scroll trap on a reporting form. Re-measure if questions
                 are added — load the embed URL directly at each width and read
                 document.documentElement.scrollHeight. -->
            <!-- Skeleton for the embed. An iframe is transparent until the framed
                 document paints, so the placeholder just sits behind it and is covered
                 the moment Google's white background arrives — no load event to hook,
                 nothing to tear down. aria-hidden: the iframe's own title names the
                 region, and a screen reader has no use for fake fields.
                 A frame that fails outright paints the browser's own error page over
                 this, so there is no skeleton stuck up forever; copy.blocked below
                 covers the case where an extension leaves the frame blank instead. -->
            <div class="relative bg-white border border-border/30 mb-6">
              <div class="absolute inset-x-0 top-0 p-6 md:p-8" aria-hidden="true">
                <p class="font-montserrat text-sm text-muted mb-8">{copy.loading}</p>
                {[0, 1, 2, 3].map(() => (
                  <div class="mb-8">
                    <div class="skeleton-line h-3 w-1/3 mb-3"></div>
                    <div class="skeleton-line h-10 w-full"></div>
                  </div>
                ))}
              </div>
              <iframe
                src={embedUrl}
                title={copy.iframeTitle}
                loading="lazy"
                class="relative w-full h-[3700px] md:h-[2900px] border-0"
              >
                {copy.loading}
              </iframe>
            </div>

            <p class="font-montserrat text-sm text-muted leading-relaxed">
              {copy.blocked}{' '}
              <a
                href={standaloneUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary font-semibold underline underline-offset-4 hover:text-border transition-colors"
              >
                {copy.openTab}
              </a>
            </p>
          </>
        ) : (
          <div class="bg-white border border-border/30 p-8">
            <h2 class="font-unbounded font-bold text-lg text-ink mb-3">{copy.pendingTitle}</h2>
            <p class="font-montserrat text-sm text-ink/80 leading-relaxed mb-4">{copy.pendingBody}</p>
            <a
              href={`mailto:${fallbackEmail}`}
              class="font-montserrat text-sm font-semibold text-primary underline underline-offset-4 hover:text-border transition-colors"
            >
              {fallbackEmail}
            </a>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Field placeholders for the embedded form. The global reduced-motion guard in
     global.css already flattens this pulse — no local media query needed. */
  .skeleton-line {
    background-color: color-mix(in srgb, var(--color-border) 14%, transparent);
    animation: skeleton-pulse 1.8s var(--ease-soft) infinite;
  }

  @keyframes skeleton-pulse {
    50% {
      opacity: 0.4;
    }
  }
</style>
