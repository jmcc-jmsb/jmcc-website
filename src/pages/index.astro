---
// ABOUTME: Home page (EN; /fr/index.astro imports this) — hero, stats, case-comp definition,
// ABOUTME: featured disciplines, competitions preview, Wolfpack recruitment band, Instagram grid, alumni strip (Phase 2 §2 + 2B).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import StatCounter from '../components/StatCounter.astro';
import BandBlend from '../components/BandBlend.astro';
import AlumniMarquee from '../components/AlumniMarquee.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import statsData from '../data/stats.json';
import competitions from '../data/competitions.json';
import site from '../data/site.json';
import instagram from '../data/instagram.json';
import contact from '../data/contact.json';
import { photos } from '../data/photos';
import { highlights, competitionName, disciplineName } from '../data/results';

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => getLocalizedPath(p, lang);

const copy = {
  en: {
    title: 'JMCC — John Molson Competition Committee',
    description:
      "The world's largest case competition program. JMSB delegates compete at business case competitions across Canada and around the globe.",
    eyebrow: 'The John Molson Competition Committee',
    heroTitle: 'We Compete.',
    heroSub: "The World's Largest Case Competition Program",
    heroCta: 'Get Involved',
    heroSecondary: 'Who We Are',
    defnTitle: 'What Is a Case Competition?',
    defnBody:
      'A case competition is academic sport. Teams get a real business problem, a few hours to solve it, and a panel of industry judges they have to convince. Delegates spend months learning to think faster and hold their nerve, then represent John Molson against the best business schools in the world.',
    discTitle: '30+ Disciplines',
    discSub: 'Our delegates compete across every corner of business.',
    discCta: 'See all disciplines',
    whereTitle: 'Where We Compete',
    whereBody:
      "Quebec's flagship regional games, national championships, and international competitions on five continents. Wherever business schools compete, the Wolfpack shows up.",
    whereCta: 'See Our Competitions',
    joinTitle: 'Join the Wolfpack',
    joinBody:
      'Compete internationally, train with top coaches, and leave with a network that reaches across the business world. Recruitment opens every fall, and it starts with one application.',
    joinCta: 'Get Involved',
    joinMailingCta: 'Join the Mailing List',
    igTitle: 'Latest on Instagram',
    igFollow: 'Follow',
    podiumTitle: 'Most Recent Podiums',
    podiumCta: 'See the trophy cabinet',
    podiumPlacement: { 1: '1st', 2: '2nd', 3: '3rd' },
  },
  fr: {
    title: 'JMCC — Comité des compétitions John Molson',
    description:
      'Le plus grand programme de compétitions de cas au monde. Les délégués de JMSB compétitionnent au Canada et partout dans le monde.',
    eyebrow: 'Le John Molson Competition Committee',
    // Brand terms stay in English in FR copy — never « Nous compétitionnons ».
    heroTitle: 'We Compete.',
    heroSub: 'Le plus grand programme de compétitions de cas au monde',
    heroCta: 'S’impliquer',
    heroSecondary: 'Qui sommes-nous',
    defnTitle: "Qu’est-ce qu’une compétition de cas ?",
    defnBody:
      "Une compétition de cas, c’est du sport académique. Des équipes reçoivent un vrai problème d’affaires, quelques heures pour le résoudre et un jury de professionnels à convaincre. Les délégués s’entraînent pendant des mois à penser plus vite et à garder leur sang-froid, puis représentent John Molson face aux meilleures écoles de gestion au monde.",
    discTitle: '30+ disciplines',
    discSub: "Nos délégués compétitionnent dans tous les domaines des affaires.",
    discCta: 'Voir toutes les disciplines',
    whereTitle: 'Où nous compétitionnons',
    whereBody:
      'Les jeux régionaux phares du Québec, les championnats nationaux et des compétitions internationales sur cinq continents. Partout où les écoles de gestion s’affrontent, le Wolfpack répond présent.',
    whereCta: 'Voir nos compétitions',
    joinTitle: 'Rejoins le Wolfpack',
    joinBody:
      "Compétitionne à l’international, entraîne-toi avec les meilleurs coachs et repars avec un réseau qui s’étend dans le monde des affaires. Le recrutement des délégués a lieu chaque automne, et tout commence par une candidature.",
    joinCta: 'S’impliquer',
    joinMailingCta: 'S’inscrire à l’infolettre',
    igTitle: 'Récemment sur Instagram',
    igFollow: 'Suivre',
    podiumTitle: 'Nos derniers podiums',
    podiumCta: 'Voir le palmarès',
    podiumPlacement: { 1: '1re', 2: '2e', 3: '3e' },
  },
}[lang];

const stats = statsData.stats.map((s) => ({
  value: s.value,
  suffix: s.suffix,
  label: s.label[lang],
}));

// Featured disciplines only (currently the 7 JMSB majors, picked via the featured flag in
// competitions.json). The first-six fallback is a guard, not scaffolding: data
// re-exports have shipped with fields blanked before, and this block should
// degrade to a sensible selection rather than render an empty grid.
const allDisciplines = competitions.disciplines.items.filter((d) => !d.slug.startsWith('TODO'));
const featuredDisciplines = allDisciplines.filter((d) => d.featured);
const shownDisciplines = (featuredDisciplines.length > 0 ? featuredDisciplines : allDisciplines.slice(0, 6)).map(
  (d) => ({
    name: d.name[lang],
    // The hover reveal takes the short copy where there is one. The full descriptions
    // are written for /disciplines and run long enough that the clamp cuts them
    // mid-sentence; see _short in competitions.json.
    description:
      d.short?.[lang] ||
      (d.description?.[lang] && !d.description[lang].startsWith('TODO') ? d.description[lang] : null),
    // Lands on the section for the first competition that runs it. Also what makes
    // the card focusable, so the hover reveal is reachable from the keyboard.
    href: d.competitions[0] ? `${L('/disciplines')}#${d.competitions[0]}` : L('/disciplines'),
  }),
);

const regionalNames = competitions.regionals.flatMap((g) => g.items.map((i) => i.name[lang]));

// Recruitment band CTA follows site.json → recruitmentOpen (§5). While recruitment
// is open there is more than one sign-up form, and they all live on Get Involved —
// the band routes there rather than picking one of them for the visitor. That is
// also the fallback when the mailing-list URL is unset, so this slot is never dead.
const mailingReady = Boolean(site.mailingListUrl && !site.mailingListUrl.startsWith('TODO'));
const joinCta = !site.recruitmentOpen && mailingReady
  ? { href: site.mailingListUrl, label: copy.joinMailingCta, external: true }
  : { href: L('/get-involved'), label: copy.joinCta, external: false };

// Latest on Instagram — manually curated grid: local images, no
// third-party script, no API token. Renders nothing while instagram.json is empty.
const igModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/instagram/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
type IgPost = { image: string; alt: Record<string, string>; permalink: string };
const igPosts = (instagram.posts as IgPost[])
  .map((p) => ({ ...p, src: igModules[`../assets/instagram/${p.image}`]?.default || null }))
  .filter((p) => p.src && p.permalink);
const igAccount = contact.socials.find((s) => s.platform === 'instagram');
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main>
    <!-- 2.1 Hero — split layout: text on solid primary, photo beside (no text over photos, §0.2) -->
    <section class="grid md:grid-cols-2 min-h-[70vh]">
      <div class="bg-primary flex items-center">
        <div class="px-6 md:px-14 lg:px-20 py-20 max-w-2xl">
          <p class="font-montserrat text-sm font-semibold text-sand uppercase tracking-widest mb-5">
            {copy.eyebrow}
          </p>
          <h1 class="font-unbounded font-extrabold text-5xl md:text-6xl text-cream leading-tight mb-6">
            {copy.heroTitle}
          </h1>
          <p class="font-montserrat text-lg text-cream/80 mb-10 leading-relaxed">
            {copy.heroSub}
          </p>
          <div class="flex flex-wrap items-center gap-6">
            <Button variant="cta" href={L('/get-involved')} label={copy.heroCta} />
            <a
              href={L('/who-we-are')}
              class="font-montserrat text-sm font-semibold text-cream uppercase tracking-widest underline underline-offset-8 decoration-sand hover:text-gold transition-colors"
            >
              {copy.heroSecondary} →
            </a>
          </div>
        </div>
      </div>
      <div class="relative min-h-80">
        <Image
          src={photos.delegationStage.src}
          alt={photos.delegationStage.alt[lang]}
          widths={[768, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          quality={72}
          class="absolute inset-0 w-full h-full object-cover"
          style={`object-position: ${photos.delegationStage.focal}`}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- 2.3 What is a case competition -->
    <section class="bg-cream py-24 px-6">
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <h2 class="font-unbounded font-bold text-3xl md:text-4xl text-ink mb-8">{copy.defnTitle}</h2>
        <p class="font-montserrat text-lg text-ink/80 leading-relaxed">{copy.defnBody}</p>
      </div>
    </section>

    <!-- 2.2 Stats band -->
    <StatCounter stats={stats} bgColor="ink" />

    <!-- 2.4 Featured disciplines — one card per JMSB major, hover
         reveals the description on pointer devices; always visible on touch. On
         primary so the page keeps alternating after the beige divider strip was
         removed (§13). -->
    <section class="relative bg-primary py-24 px-6">
      <BandBlend from="ink" />
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="font-unbounded font-bold text-3xl text-cream mb-4" data-reveal>{copy.discTitle}</h2>
        <p class="font-montserrat text-sand mb-12" data-reveal>{copy.discSub}</p>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 auto-rows-fr gap-5 mb-12" role="list" data-reveal-group>
          {shownDisciplines.map((d) => (
            <li class="disc-card">
              <a href={d.href} class="disc-panel flex flex-col justify-center bg-cream p-6">
                <h3 class="font-unbounded font-bold text-base text-ink">{d.name}</h3>
                {d.description && (
                  <div class="disc-reveal">
                    <div class="overflow-hidden">
                      {/* clamp-4, not 3: at the lg 3-column width the real descriptions
                          run to four lines and 3 cut them mid-sentence. Still clamped so
                          an overlong future entry cannot stretch the overlay unbounded. */}
                      <p class="font-montserrat text-sm text-muted leading-relaxed pt-3 line-clamp-4 text-left">
                        {d.description}
                      </p>
                    </div>
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
        <div data-reveal>
          <a
            href={L('/disciplines')}
            class="font-montserrat text-sm font-semibold text-cream uppercase tracking-widest underline underline-offset-8 decoration-sand hover:text-gold transition-colors"
          >
            {copy.discCta} →
          </a>
        </div>
      </div>
    </section>

    <!-- 2.5 Where we compete — condensed preview, single CTA. Cream against the
         primary band above (§13). -->
    <section class="relative bg-cream py-24 px-6">
      <BandBlend from="primary" />
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-unbounded font-bold text-3xl text-ink mb-6" data-reveal>{copy.whereTitle}</h2>
        <p class="font-montserrat text-ink/80 leading-relaxed max-w-2xl mx-auto mb-10" data-reveal>
          {copy.whereBody}
        </p>
        <ul class="flex flex-wrap justify-center gap-3 mb-12" role="list" data-reveal-group>
          {regionalNames.map((name) => (
            <li class="font-montserrat text-sm font-semibold text-primary uppercase tracking-wide px-4 py-2 border border-primary/30">
              {name}
            </li>
          ))}
        </ul>
        <div data-reveal>
          <Button variant="primary" href={L('/competitions')} label={copy.whereCta} />
        </div>
      </div>
    </section>

    <!-- Full-delegation band — full-bleed, no text over it (§0.2). The photo stands
         alone: no visible caption; alt text stays for screen readers. -->
    <div class="relative bg-ink">
      <BandBlend from="cream" />
      <Image
        src={photos.delegationGala.src}
        alt={photos.delegationGala.alt[lang]}
        widths={[768, 1280, 1600, 2000]}
        sizes="100vw"
        quality={72}
        class="w-full h-[45vh] md:h-[60vh] object-cover"
        style={`object-position: ${photos.delegationGala.focal}`}
      />
    </div>

    <!-- Most recent podiums — the newest season only, up to four. Hidden entirely
         while results.json is empty, and the medal treatment stays on /trophy-cabinet
         where the dark bands make gold and sand legal (CLAUDE.md). -->
    {highlights.length > 0 && (
      <section class="relative bg-cream py-20 px-6">
        <BandBlend from="ink" />
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="font-unbounded font-bold text-3xl text-ink mb-10" data-reveal>
            {copy.podiumTitle}
          </h2>
          <ul class="grid sm:grid-cols-2 gap-4 text-left mb-10" role="list" data-reveal-group>
            {highlights.map((r) => (
              <li class="border border-primary/30 px-5 py-4">
                <p class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest mb-1">
                  {copy.podiumPlacement[r.placement as 1 | 2 | 3]} · {r.season}
                </p>
                <p class="font-unbounded font-bold text-base text-ink">
                  {r.discipline ? disciplineName(r.discipline, lang) : competitionName(r.competition, lang)}
                </p>
                {r.discipline && (
                  <p class="font-montserrat text-sm text-muted">
                    {competitionName(r.competition, lang)}
                  </p>
                )}
              </li>
            ))}
          </ul>
          <div data-reveal>
            <a
              href={L('/trophy-cabinet')}
              class="font-montserrat text-sm font-semibold text-primary uppercase tracking-widest underline underline-offset-8 decoration-primary/40 hover:text-border transition-colors"
            >
              {copy.podiumCta} →
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- 2.7 Join the Wolfpack recruitment band (replaces the old article grid) -->
    <section class="bg-ink grid md:grid-cols-2">
      <div class="relative min-h-72 order-last md:order-first">
        <Image
          src={photos.paradeCrowd.src}
          alt={photos.paradeCrowd.alt[lang]}
          widths={[768, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          quality={72}
          class="absolute inset-0 w-full h-full object-cover"
          style={`object-position: ${photos.paradeCrowd.focal}`}
        />
      </div>
      <div class="flex items-center px-6 md:px-14 py-20">
        <div data-reveal>
          <h2 class="font-unbounded font-bold text-3xl md:text-4xl text-gold mb-5">{copy.joinTitle}</h2>
          <p class="font-montserrat text-cream/80 leading-relaxed mb-8 max-w-lg">{copy.joinBody}</p>
          <Button
            variant="cta"
            href={joinCta.href}
            target={joinCta.external ? '_blank' : undefined}
            label={joinCta.label}
          />
        </div>
      </div>
    </section>

    <!-- Latest on Instagram (replaces the social icon band — the
         footer already carries the icons). Hidden entirely while instagram.json is
         empty: a stale feed is worse than none. -->
    {igPosts.length > 0 && igAccount && (
      <section class="bg-cream py-24 px-6">
        <div class="max-w-5xl mx-auto text-center">
          <h2 class="font-unbounded font-bold text-3xl text-ink mb-3" data-reveal>{copy.igTitle}</h2>
          <a
            href={igAccount.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-montserrat text-sm font-semibold text-primary hover:text-border transition-colors mb-10"
            data-reveal
          >
            {copy.igFollow} {igAccount.handle} →
          </a>
          {/* A real grid rather than wrapping flex: fixed-width flex items rewrap at
              widths nobody picked, so 6 posts landed 4-then-2. 3 across (2 on phones)
              means both supported counts — 3 and 6 — fill their rows exactly. */}
          <ul
            class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-3xl mx-auto"
            role="list"
            data-reveal-group
          >
            {igPosts.map((post) => (
              <li>
                <a href={post.permalink} target="_blank" rel="noopener noreferrer" class="block group">
                  {/* 4:5, not square: JMCC posts its graphics in Instagram's portrait
                      format and a square crop cuts the headline text off them. */}
                  <Image
                    src={post.src!}
                    alt={post.alt[lang]}
                    widths={[256, 512]}
                    sizes="(min-width: 640px) 256px, 45vw"
                    quality={72}
                    class="w-full aspect-[4/5] object-cover group-hover:opacity-85 transition-opacity duration-quick"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Where our alumni work — hidden while alumni-companies.json is empty. -->
    <AlumniMarquee />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Discipline card hover (§11): the card enlarges and its description opens.
     The default state below is the TOUCH state — description visible, no hover
     required. A hover-only reveal is invisible to half the audience, so the
     enlarging overlay is layered on top only where hovering actually exists. */
  /* Every card is the same size regardless of how many lines its title wraps to.
     auto-rows-fr on the grid squares the rows off against each other; these two
     rules make the cream panel fill its cell rather than shrink to its text, which
     is what left the one-line titles visibly shorter than the two-line one. */
  .disc-card {
    display: flex;
  }
  .disc-panel {
    flex: 1;
  }

  /* Seven cards in three columns leave one orphan on the last row. Centre it
     instead of letting it sit alone in the first column. The nth-child guard means
     this only fires when the count actually leaves a single card over: at six or
     eight featured disciplines the rule does nothing. */
  @media (min-width: 1024px) {
    .disc-card:last-child:nth-child(3n + 1) {
      grid-column-start: 2;
    }
  }

  /* Nothing outside the query: with no hover, .disc-reveal is an ordinary block
     and the description simply renders. Every collapse rule lives inside. */
  @media (hover: hover) {
    /* The panel is lifted out of flow so that growing it cannot reflow the
       grid — it expands over the row beneath instead, which is the effect.
       The li keeps the cell's height; only the panel moves. */
    .disc-card {
      position: relative;
      /* Tall enough for a two-line title ("Operations and Logistics Management")
         to fit inside the cell. Below this the panel outgrows its cell and that
         one card renders taller than the rest. */
      min-height: 6rem;
    }
    .disc-panel {
      position: absolute;
      inset-inline: 0;
      top: 0;
      /* min-height, not height: the panel has to fill the cell so every card reads
         the same size, but still grow past it when the description opens. A fixed
         height would clip the reveal instead of expanding over the row below. */
      min-height: 100%;
      transition:
        transform var(--duration-quick) var(--ease-soft),
        box-shadow var(--duration-quick) var(--ease-soft);
    }
    /* Same technique as the /faq disclosure: height: auto does not transition.
       The inner overflow-hidden div is what clips the copy while collapsed. */
    .disc-reveal {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows var(--duration-quick) var(--ease-soft);
    }

    /* focus-visible rather than focus, so clicking a card with the mouse does
       not leave it stuck open once the pointer moves away. */
    .disc-card:hover .disc-panel,
    .disc-panel:focus-visible {
      transform: scale(1.06);
      box-shadow: 0 12px 28px rgb(0 0 0 / 0.28);
      z-index: 10;
    }
    .disc-card:hover .disc-reveal,
    .disc-panel:focus-visible .disc-reveal {
      grid-template-rows: 1fr;
    }
  }

  /* The enlarge is the flourish, the description is the content: under reduced
     motion drop the scale and keep the reveal. */
  @media (prefers-reduced-motion: reduce) {
    .disc-card:hover .disc-panel,
    .disc-panel:focus-visible {
      transform: none;
    }
  }
</style>
