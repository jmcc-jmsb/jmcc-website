---
// ABOUTME: Competitions (EN; /fr imports this) — merged internationals + regionals page (Phase 2 §7).
// ABOUTME: Internationals lead; regionals in two labeled groups from competitions.json.
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SafeImage from '../components/SafeImage.astro';
import { getLangFromUrl } from '../i18n/utils';
import competitions from '../data/competitions.json';

const lang = getLangFromUrl(Astro.url);

// Competition logos live in /src/assets/competitions/ — 2026–2027 editions only (§7).
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/competitions/*.{jpg,jpeg,png,webp,svg}',
  { eager: true },
);
const logoFor = (p: string | null): ImageMetadata | null =>
  (p && !p.startsWith('TODO') && logoModules[`../assets/competitions/${p}`]?.default) || null;

const internationals = competitions.internationals.items.filter(
  (i) => !i.slug.startsWith('TODO'),
);

// Grouped by term, in order of first appearance in the data — array order is provisional,
// so nothing about the ordering is hardcoded here (competitions.json `_order`).
const intlTerms = [...new Set(internationals.map((i) => i.term))].map((term) => {
  const items = internationals.filter((i) => i.term === term);
  return { term, label: items[0].termLabel[lang], items };
});

const copy = {
  en: {
    title: 'Competitions — JMCC',
    description:
      'Where the Wolfpack competes: national and international case competitions plus Quebec’s flagship regional games.',
    heroTitle: 'Where We Compete',
    heroSub:
      'From regional games, to national championships, to the world stage — JMCC delegations compete at every level.',
    intlTitle: 'Nationals & Internationals',
    intlComingSoonChip: 'Lineup coming soon',
    intlComingSoonBody:
      'The 2026–2027 national and international competition lineup is being finalized and will be announced here.',
    regTitle: 'Regionals',
    regSub:
      'Quebec and Central Canada’s inter-university circuit — where most delegates first earn their stripes.',
    visit: 'Visit site',
  },
  fr: {
    title: 'Compétitions — JMCC',
    description:
      'Où la meute compétitionne : compétitions de cas nationales et internationales et jeux régionaux phares du Québec.',
    heroTitle: 'Où nous compétitionnons',
    heroSub:
      'Des jeux régionaux aux championnats nationaux jusqu’à la scène mondiale — les délégations du JMCC compétitionnent à tous les niveaux.',
    intlTitle: 'Nationales et internationales',
    intlComingSoonChip: 'Liste bientôt disponible',
    intlComingSoonBody:
      'La liste des compétitions nationales et internationales 2026–2027 est en cours de finalisation et sera annoncée ici.',
    regTitle: 'Régionales',
    regSub:
      'Le circuit interuniversitaire du Québec et du Canada central — là où la plupart des délégués font leurs premières armes.',
    visit: 'Visiter le site',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main>
    <!-- Hero + intro (§7.1) -->
    <section class="bg-primary py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <h1 class="font-unbounded font-bold text-4xl md:text-6xl text-cream leading-tight mb-6">
          {copy.heroTitle}
        </h1>
        <p class="font-montserrat text-lg text-cream/80 max-w-2xl leading-relaxed">{copy.heroSub}</p>
      </div>
    </section>

    <!-- Nationals & Internationals — first and most prominent (§7.2) -->
    <section class="bg-cream py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-unbounded font-bold text-3xl md:text-4xl text-ink mb-6" data-reveal>
          {copy.intlTitle}
        </h2>
        <p class="font-montserrat text-lg text-ink/80 leading-relaxed max-w-3xl mb-14" data-reveal>
          {competitions.internationals.intro[lang]}
        </p>

        {internationals.length > 0 ? (
          <div class="space-y-14">
            {intlTerms.map((group) => (
              <div>
                <h3 class="font-unbounded font-bold text-lg text-primary mb-6" data-reveal>
                  {group.label}
                </h3>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                  {group.items.map((item, i) => (
                    <article
                      class="bg-white border border-border/20 flex flex-col hover:border-border/50 hover:-translate-y-0.5 transition-all duration-150"
                      data-reveal
                      style={`transition-delay: ${Math.min(i * 60, 300)}ms`}
                    >
                      <SafeImage
                        src={logoFor(item.logo)}
                        alt={`${item.name[lang]} logo`}
                        class="aspect-video min-h-0 border-b border-border/10"
                        imgClass="w-full h-full object-contain p-6"
                      />
                      <div class="p-6 flex flex-col flex-1">
                        <p class="font-montserrat text-xs font-semibold text-muted uppercase tracking-widest mb-2">
                          {item.abbr}
                        </p>
                        <h4 class="font-unbounded font-bold text-base text-ink mb-2">{item.name[lang]}</h4>
                        <p class="font-montserrat text-xs text-muted mb-1">
                          {item.city}, {item.country[lang]}
                        </p>
                        <p class="font-montserrat text-xs text-muted mb-3">{item.host}</p>
                        {item.blurb?.[lang] && !item.blurb[lang].startsWith('TODO') && (
                          <p class="font-montserrat text-sm text-ink/80 leading-relaxed mb-4 flex-1">
                            {item.blurb[lang]}
                          </p>
                        )}
                        {item.url && (
                          <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-auto pt-2 font-montserrat text-xs font-semibold text-primary uppercase tracking-widest hover:text-border transition-colors"
                          >
                            {copy.visit} →
                          </a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="border border-border/30 bg-white p-12 text-center" data-reveal>
            <span class="inline-block border border-primary text-primary font-montserrat text-xs font-semibold uppercase tracking-widest px-4 py-2 mb-6">
              {copy.intlComingSoonChip}
            </span>
            <p class="font-montserrat text-muted leading-relaxed max-w-xl mx-auto">
              {copy.intlComingSoonBody}
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- Regionals in two labeled groups (§7.3) -->
    <section class="bg-ink py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-unbounded font-bold text-3xl text-cream mb-4" data-reveal>{copy.regTitle}</h2>
        <p class="font-montserrat text-cream/70 leading-relaxed max-w-2xl mb-14" data-reveal>
          {copy.regSub}
        </p>

        <div class="space-y-16">
          {competitions.regionals.map((group) => (
            <div>
              <h3 class="font-unbounded font-bold text-xl text-gold mb-2">{group.groupLabel[lang]}</h3>
              <p class="font-montserrat text-sm text-sand mb-8">{group.groupBlurb[lang]}</p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {group.items.map((item, i) => (
                  <article
                    class="bg-cream flex flex-col hover:-translate-y-0.5 transition-transform duration-150"
                    data-reveal
                    style={`transition-delay: ${Math.min(i * 60, 300)}ms`}
                  >
                    <SafeImage
                      src={logoFor(item.logo)}
                      alt={`${item.name[lang]} logo`}
                      class="aspect-video min-h-0 border-b border-border/10"
                      imgClass="w-full h-full object-contain p-6"
                    />
                    <div class="p-6 flex flex-col flex-1">
                      <h4 class="font-unbounded font-bold text-base text-ink mb-3">{item.name[lang]}</h4>
                      {item.blurb?.[lang] && !item.blurb[lang].startsWith('TODO') && (
                        <p class="font-montserrat text-sm text-ink/80 leading-relaxed mb-4 flex-1">
                          {item.blurb[lang]}
                        </p>
                      )}
                      {item.url && (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-auto font-montserrat text-xs font-semibold text-primary uppercase tracking-widest hover:text-border transition-colors"
                        >
                          {copy.visit} →
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
