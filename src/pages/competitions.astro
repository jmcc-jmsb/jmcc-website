---
// ABOUTME: Competitions (EN; /fr imports this) — merged internationals + regionals page (Phase 2 §7).
// ABOUTME: Internationals lead; regionals in two labeled groups from competitions.json.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SafeImage from '../components/SafeImage.astro';
import ClawDefs from '../components/ClawDefs.astro';
import ClawFlick from '../components/ClawFlick.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import competitions from '../data/competitions.json';
import { photos } from '../data/photos';
import { podiumsFor, podiumsSince, baseSlug } from '../data/results';

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => getLocalizedPath(p, lang);

// Competition logos live in /src/assets/competitions/ — 2026–2027 editions only (§7).
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/competitions/*.{jpg,jpeg,png,webp,svg}',
  { eager: true },
);

// Logos resolve by slug: every asset is named <slug>.<ext>. The data file's
// `logo` field is only consulted when it points at a differently-named file.
// Marketing's exports keep shipping that field as null or TODO_LOGO_*, and the
// logos should not vanish from the site each time they do — so the filename is
// derived rather than stored. Drop in <slug>.png and it appears; no data edit.
const logoFor = (slug: string, named: string | null): ImageMetadata | null => {
  const explicit =
    named && !named.startsWith('TODO')
      ? logoModules[`../assets/competitions/${named}`]?.default
      : null;
  if (explicit) return explicit;
  for (const ext of ['png', 'jpg', 'jpeg', 'webp', 'svg']) {
    const hit = logoModules[`../assets/competitions/${slug}.${ext}`]?.default;
    if (hit) return hit;
  }
  return null;
};

const internationals = competitions.internationals.items.filter(
  (i) => !i.slug.startsWith('TODO'),
);

// Grouped by term, in order of first appearance in the data — array order is provisional,
// so nothing about the ordering is hardcoded here (competitions.json `_order`).
const intlTerms = [...new Set(internationals.map((i) => i.term))].map((term) => {
  const items = internationals.filter((i) => i.term === term);
  return { term, label: items[0].termLabel[lang], items };
});

const copy = {
  en: {
    title: 'Competitions — JMCC',
    description:
      'Where the Wolfpack competes: national and international case competitions plus Quebec’s flagship regional games.',
    heroTitle: 'Where We Compete',
    heroSub:
      'Regional games, national championships, the world stage. JMCC delegations compete at every level.',
    intlTitle: 'Nationals & Internationals',
    intlComingSoonChip: 'Lineup coming soon',
    intlComingSoonBody:
      'The 2026–2027 national and international competition lineup is being finalized and will be announced here.',
    regTitle: 'Regionals',
    regSub:
      'Quebec and Central Canada’s inter-university circuit, where most delegates first earn their stripes.',
    visit: 'Visit site',
    disciplines: 'See disciplines',
    podiumOne: 'podium',
    podiumMany: 'podiums',
    podiumSince: 'since',
  },
  fr: {
    title: 'Compétitions — JMCC',
    description:
      'Où le Wolfpack compétitionne : compétitions de cas nationales et internationales, et jeux régionaux phares du Québec.',
    heroTitle: 'Où nous compétitionnons',
    heroSub:
      'Jeux régionaux, championnats nationaux, scène mondiale. Les délégations du JMCC compétitionnent à tous les niveaux.',
    intlTitle: 'Nationales et internationales',
    intlComingSoonChip: 'Liste bientôt disponible',
    intlComingSoonBody:
      'La liste des compétitions nationales et internationales 2026–2027 est en cours de finalisation et sera annoncée ici.',
    regTitle: 'Régionales',
    regSub:
      'Le circuit interuniversitaire du Québec et du Canada central, là où la plupart des délégués font leurs premières armes.',
    visit: 'Visiter le site',
    disciplines: 'Voir les disciplines',
    podiumOne: 'podium',
    podiumMany: 'podiums',
    podiumSince: 'depuis',
  },
}[lang];

// "12 podiums since 2022" under a card, counted from results.json. Returns null until
// there are results for that competition — a card announcing zero podiums is worse
// than one that says nothing.
const podiumLine = (slug: string) => {
  const count = podiumsFor(slug);
  if (count === 0) return null;
  const since = podiumsSince(slug);
  const label = `${count} ${count === 1 ? copy.podiumOne : copy.podiumMany}`;
  return since ? `${label} ${copy.podiumSince} ${since}` : label;
};

// The cabinet filters on the slug without its edition year, the same key results.json
// uses. Passing the raw '-2026' slug through would filter the page down to nothing.
const cabinetHref = (slug: string) => `${L('/trophy-cabinet')}?competition=${baseSlug(slug)}`;
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <ClawDefs />
  <main>
    <!-- Hero + intro (§7.1) -->
    <section class="bg-primary py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <h1 class="font-unbounded font-bold text-4xl md:text-6xl text-cream leading-tight mb-6">
          {copy.heroTitle}
        </h1>
        <p class="font-montserrat text-lg text-cream/80 max-w-2xl leading-relaxed">{copy.heroSub}</p>
      </div>
    </section>

    <!-- Nationals & Internationals — first and most prominent (§7.2) -->
    <section class="relative bg-cream py-24 px-6 overflow-hidden">
      <!-- Faded world map: decorative texture only — deliberately
           low-poly, no labels, no data, and faint enough never to fight text
           contrast. SVG, not a raster: a handful of rough continent polygons. -->
      <svg
        class="absolute inset-0 w-full h-full text-primary opacity-[0.07]"
        viewBox="0 0 1000 500"
        preserveAspectRatio="xMidYMid slice"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M60 90 L180 62 L258 88 L276 128 L232 158 L252 192 L212 232 L162 212 L120 162 L78 132 Z" />
        <path d="M298 52 L352 40 L364 72 L322 88 Z" />
        <path d="M238 268 L292 256 L312 300 L302 358 L272 420 L250 372 L234 310 Z" />
        <path d="M468 82 L532 68 L562 100 L540 132 L490 142 L464 112 Z" />
        <path d="M468 160 L542 150 L582 192 L572 252 L532 322 L500 332 L470 262 L454 202 Z" />
        <path d="M560 62 L702 48 L822 78 L872 120 L832 172 L762 202 L700 232 L648 182 L590 152 L558 112 Z" />
        <path d="M660 240 L700 248 L692 292 L668 278 Z" />
        <path d="M788 300 L862 288 L892 330 L850 372 L800 352 Z" />
      </svg>
      <div class="relative max-w-6xl mx-auto">
        <h2 class="font-unbounded font-bold text-3xl md:text-4xl text-ink mb-6" data-reveal>
          {copy.intlTitle}
        </h2>
        <p class="font-montserrat text-lg text-ink/80 leading-relaxed max-w-3xl mb-14" data-reveal>
          {competitions.internationals.intro[lang]}
        </p>

        {internationals.length > 0 ? (
          <div class="space-y-14">
            {intlTerms.map((group) => (
              <div>
                <h3 class="font-unbounded font-bold text-lg text-primary mb-6" data-reveal>
                  {group.label}
                </h3>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-group>
                  {group.items.map((item) => (
                    <article
                      class="group relative overflow-hidden bg-white border border-border/20 flex flex-col hover:border-border/50 hover:-translate-y-0.5 transition-[border-color,transform] duration-quick"
                    >
                      <ClawFlick />
                      <SafeImage
                        src={logoFor(item.slug, item.logo)}
                        alt={`${item.name[lang]} logo`}
                        class="aspect-video min-h-0 border-b border-border/10"
                        imgClass="w-full h-full object-contain p-6"
                      />
                      <div class="p-6 flex flex-col flex-1">
                        <p class="font-montserrat text-xs font-semibold text-muted uppercase tracking-widest mb-2">
                          {item.abbr}
                        </p>
                        <h4 class="font-unbounded font-bold text-base text-ink mb-2">{item.name[lang]}</h4>
                        <p class="font-montserrat text-xs text-muted mb-1">
                          {item.city}, {item.country[lang]}
                        </p>
                        <p class="font-montserrat text-xs text-muted mb-3">{item.host}</p>
                        {podiumLine(item.slug) && (
                          <a
                            href={cabinetHref(item.slug)}
                            class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest mb-3 hover:text-border transition-colors"
                          >
                            {podiumLine(item.slug)} →
                          </a>
                        )}
                        {item.blurb?.[lang] && !item.blurb[lang].startsWith('TODO') && (
                          <p class="font-montserrat text-sm text-ink/80 leading-relaxed mb-4 flex-1">
                            {item.blurb[lang]}
                          </p>
                        )}
                        {item.url && (
                          <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-auto pt-2 font-montserrat text-xs font-semibold text-primary uppercase tracking-widest hover:text-border transition-colors"
                          >
                            {copy.visit} →
                          </a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="border border-border/30 bg-white p-12 text-center" data-reveal>
            <span class="inline-block border border-primary text-primary font-montserrat text-xs font-semibold uppercase tracking-widest px-4 py-2 mb-6">
              {copy.intlComingSoonChip}
            </span>
            <p class="font-montserrat text-muted leading-relaxed max-w-xl mx-auto">
              {copy.intlComingSoonBody}
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- Regionals in two labeled groups (§7.3) -->
    <section class="bg-ink py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-unbounded font-bold text-3xl text-cream mb-4" data-reveal>{copy.regTitle}</h2>
        <p class="font-montserrat text-cream/70 leading-relaxed max-w-2xl mb-10" data-reveal>
          {copy.regSub}
        </p>

        <Image
          src={photos.delegationArch.src}
          alt={photos.delegationArch.alt[lang]}
          widths={[768, 1280, 1600]}
          sizes="(min-width: 1200px) 1152px, 100vw"
          quality={72}
          class="w-full h-64 md:h-96 object-cover mb-16"
          style={`object-position: ${photos.delegationArch.focal}`}
        />

        <div class="space-y-16">
          {competitions.regionals.map((group) => (
            <div>
              <h3 class="font-unbounded font-bold text-xl text-gold mb-2">{group.groupLabel[lang]}</h3>
              <p class="font-montserrat text-sm text-sand mb-8">{group.groupBlurb[lang]}</p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
                {group.items.map((item) => (
                  <article
                    class="group relative overflow-hidden bg-cream flex flex-col hover:-translate-y-0.5 transition-transform duration-quick"
                  >
                    <ClawFlick />
                    <SafeImage
                      src={logoFor(item.slug, item.logo)}
                      alt={`${item.name[lang]} logo`}
                      class="aspect-video min-h-0 border-b border-border/10"
                      imgClass="w-full h-full object-contain p-6"
                    />
                    <div class="p-6 flex flex-col flex-1">
                      <h4 class="font-unbounded font-bold text-base text-ink mb-2">{item.name[lang]}</h4>
                      {item.location?.[lang] && (
                        <p class="font-montserrat text-xs text-muted mb-3">{item.location[lang]}</p>
                      )}
                      {podiumLine(item.slug) && (
                        <a
                          href={cabinetHref(item.slug)}
                          class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest mb-3 hover:text-border transition-colors"
                        >
                          {podiumLine(item.slug)} →
                        </a>
                      )}
                      {item.blurb?.[lang] && !item.blurb[lang].startsWith('TODO') && (
                        <p class="font-montserrat text-sm text-ink/80 leading-relaxed mb-4 flex-1">
                          {item.blurb[lang]}
                        </p>
                      )}
                      <div class="mt-auto flex flex-wrap gap-x-5 gap-y-1">
                        <!-- Each regional card deep-links to its own section on
                             /disciplines. A plain anchor, so it needs no JS (§10). -->
                        <a
                          href={`${L('/disciplines')}#${item.slug}`}
                          class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest hover:text-border transition-colors"
                        >
                          {copy.disciplines} →
                        </a>
                        {item.url && (
                          <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest hover:text-border transition-colors"
                          >
                            {copy.visit} →
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
