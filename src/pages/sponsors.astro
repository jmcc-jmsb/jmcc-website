---
// ABOUTME: Sponsors (EN; /fr imports this) — static tiered grid from sponsors.json, no carousel (Phase 2 §5).
// ABOUTME: TODO_ tiers/sponsors are filtered out; an empty list renders a neutral coming-soon state.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import sponsorsData from '../data/sponsors.json';

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => getLocalizedPath(p, lang);

// Sponsor logos live in /src/assets/sponsors/ named sponsor-<name>.png (§5 filename rule).
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/sponsors/*.{jpg,jpeg,png,webp,svg}',
  { eager: true },
);
const logoFor = (p: string | null): ImageMetadata | null =>
  (p && logoModules[`../assets/sponsors/${p}`]?.default) || null;

const tiers = sponsorsData.tiers
  .map((t) => ({
    label: t.label[lang],
    prominence: t.prominence,
    sponsors: t.sponsors.filter((s) => !s.name.startsWith('TODO')),
  }))
  .filter((t) => !t.label.startsWith('TODO') && t.sponsors.length > 0);
const hasSponsors = tiers.length > 0;

// "More to come" only while placeholders remain in sponsors.json. Delete the last
// TODO_ tier and the line retires itself — a permanent "more coming soon" on a
// finished lineup reads as neglect.
const lineupPending = sponsorsData.tiers.some(
  (t) => t.label.en.startsWith('TODO') || t.sponsors.some((s) => s.name.startsWith('TODO')),
);

const copy = {
  en: {
    title: 'Sponsors — JMCC',
    description: 'The partners who make it possible for JMSB delegates to compete on the world stage.',
    heroTitle: 'Our Sponsors',
    heroSub: 'The partners behind every podium.',
    comingSoonChip: 'Coming soon',
    comingSoonTitle: 'Our 2026–2027 sponsor lineup is being finalized',
    comingSoonBody:
      'We are proud to work with partners who invest in the next generation of business leaders. This year’s lineup will be announced soon.',
    moreSoon: 'Our 2026–2027 lineup is still growing — more partners will be announced soon.',
    ctaLabel: 'Contact Us',
  },
  fr: {
    title: 'Commanditaires — JMCC',
    description: 'Les partenaires qui permettent aux délégués de JMSB de compétitionner sur la scène mondiale.',
    heroTitle: 'Nos commanditaires',
    heroSub: 'Les partenaires derrière chaque podium.',
    comingSoonChip: 'Bientôt disponible',
    comingSoonTitle: 'Nos commanditaires 2026–2027 seront annoncés sous peu',
    comingSoonBody:
      'Nous sommes fiers de travailler avec des partenaires qui investissent dans la prochaine génération de leaders d’affaires. La liste de cette année sera dévoilée bientôt.',
    moreSoon:
      'Notre liste 2026–2027 continue de s’enrichir — d’autres partenaires seront annoncés sous peu.',
    ctaLabel: 'Nous joindre',
  },
}[lang];

const cellSize = (prominence: string, count: number) => {
  const cap = prominence === 'large' ? '[&_img]:max-h-24' : '[&_img]:max-h-16';
  // A tier holding one sponsor — the title tier — would otherwise sit in the left
  // half of a two-column row with dead space beside it.
  if (count === 1) return `grid-cols-1 max-w-lg mx-auto ${cap}`;
  const cols =
    prominence === 'large'
      ? 'grid-cols-1 sm:grid-cols-2'
      : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4';
  return `${cols} ${cap}`;
};

// Top-tier logos run in full colour: greyscale is a levelling treatment that keeps a
// wall of mismatched marks reading as one system, which is the opposite of what a
// title sponsor is paying for. It also avoids recolouring a mark whose brand
// guidelines may not permit it.
const logoTone = (prominence: string) =>
  prominence === 'large' ? '' : 'grayscale hover:grayscale-0 transition-[filter] duration-base';
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="bg-primary py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <h1 class="font-unbounded font-bold text-4xl md:text-6xl text-cream leading-tight mb-4">
          {copy.heroTitle}
        </h1>
        <p class="font-montserrat text-lg text-sand">{copy.heroSub}</p>
      </div>
    </section>

    {hasSponsors ? (
      <section class="bg-cream py-24 px-6">
        <div class="max-w-5xl mx-auto space-y-20">
          {tiers.map((tier) => (
            <div>
              <h2 class="font-unbounded font-bold text-2xl text-ink text-center mb-10">{tier.label}</h2>
              <ul class:list={['grid gap-6', cellSize(tier.prominence, tier.sponsors.length)]} role="list">
                {tier.sponsors.map((s) => (
                  <li data-reveal>
                    {s.url ? (
                      <a
                        href={s.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center bg-white border border-border/15 p-8 h-full hover:border-border/40 hover:-translate-y-0.5 transition-[border-color,transform] duration-quick"
                      >
                        {logoFor(s.logo) ? (
                          <Image src={logoFor(s.logo)!} alt={s.name} class:list={['w-auto object-contain', logoTone(tier.prominence)]} />
                        ) : (
                          <span class="font-unbounded font-bold text-ink text-center">{s.name}</span>
                        )}
                      </a>
                    ) : (
                      <div class="flex items-center justify-center bg-white border border-border/15 p-8 h-full">
                        {logoFor(s.logo) ? (
                          <Image src={logoFor(s.logo)!} alt={s.name} class="w-auto object-contain" />
                        ) : (
                          <span class="font-unbounded font-bold text-ink text-center">{s.name}</span>
                        )}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}

          {lineupPending && (
            <p class="font-montserrat text-base text-muted text-center" data-reveal>
              {copy.moreSoon}
            </p>
          )}
        </div>
      </section>
    ) : (
      <section class="bg-cream py-32 px-6 text-center">
        <div class="max-w-xl mx-auto" data-reveal>
          <span class="inline-block border border-primary text-primary font-montserrat text-xs font-semibold uppercase tracking-widest px-4 py-2 mb-8">
            {copy.comingSoonChip}
          </span>
          <h2 class="font-unbounded font-bold text-2xl md:text-3xl text-ink mb-5">
            {copy.comingSoonTitle}
          </h2>
          <p class="font-montserrat text-muted leading-relaxed">{copy.comingSoonBody}</p>
        </div>
      </section>
    )}

    <!-- Closing partnering band (§5) -->
    <section class="bg-ink py-20 px-6 text-center">
      <div class="max-w-2xl mx-auto" data-reveal>
        <h2 class="font-unbounded font-bold text-2xl md:text-3xl text-gold mb-4">
          {sponsorsData.cta.heading[lang]}
        </h2>
        <p class="font-montserrat text-cream/80 leading-relaxed mb-8">{sponsorsData.cta.body[lang]}</p>
        <Button variant="cta" href={L(sponsorsData.cta.linkTo)} label={copy.ctaLabel} />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
