---
// ABOUTME: Get Involved (EN; /fr imports this) — sign-up section, three parallel involvement paths,
// ABOUTME: "Executive Committee" naming everywhere (Phase 2 §6). Sign-up URL comes from site.json.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import site from '../data/site.json';
import contact from '../data/contact.json';
import { photos } from '../data/photos';

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => getLocalizedPath(p, lang);

// One boolean drives the CTA here and on the home band: recruitmentOpen true →
// one "apply" button per entry in signupForms; false → "Join the mailing list" →
// mailingListUrl. Same slot, same visual weight — the page never looks broken
// between cycles (§5). Buttons carry each form's own name because there is more
// than one: an applicant picks their stream rather than being routed to a guess.
const signupForms = site.signupForms.filter((f) => f.url && !f.url.startsWith('TODO'));
const mailingReady = Boolean(site.mailingListUrl && !site.mailingListUrl.startsWith('TODO'));
const showApply = site.recruitmentOpen && signupForms.length > 0;
const showMailing = !site.recruitmentOpen && mailingReady;
const instagram = contact.socials.find((s) => s.platform === 'instagram');

const copy = {
  en: {
    title: 'Get Involved — JMCC',
    description:
      'Join the Wolfpack as a delegate, Executive Committee member, or coach. Recruitment happens every fall.',
    heroTitle: 'Get Involved',
    heroSub: 'Every wolf in the pack started with one application.',
    signupTitle: 'Delegate Sign-Ups',
    signupBody:
      'Delegate recruitment for the 2026–2027 season happens in the fall. Apply, interview, and earn your spot on a competition team.',
    signupSoon: 'Applications opening soon',
    signupFollow: 'Follow us on Instagram to catch the announcement:',
    mailingBody:
      'Recruitment is closed for now. Join the mailing list and we’ll send you competition announcements and applications for the next cycle.',
    mailingCta: 'Join the Mailing List',
    pathsTitle: 'Three Ways In',
    paths: [
      {
        heading: 'Delegate',
        body: 'Compete on a JMCC team. Train with dedicated coaches, travel with your delegation, and represent JMSB at regional, national, and international case competitions.',
      },
      {
        heading: 'Executive Committee',
        body: 'Run the program behind the Wolfpack: training, logistics, partnerships, marketing, finance, and delegate experience. Executive recruitment happens each spring.',
      },
      {
        heading: 'Coach & Volunteer',
        body: 'Alumni and industry professionals sharpen our delegates. Judge practice rounds, mentor a team, or coach a discipline you know inside out.',
      },
    ],
    closingTitle: 'Questions about joining?',
    closingCta: 'Contact Us',
  },
  fr: {
    title: 'S’impliquer — JMCC',
    description:
      'Rejoins le Wolfpack comme délégué, membre du Comité exécutif ou coach. Le recrutement a lieu chaque automne.',
    heroTitle: 'S’impliquer',
    heroSub: 'Chaque loup du Wolfpack a commencé par une candidature.',
    signupTitle: 'Inscriptions des délégués',
    signupBody:
      'Le recrutement des délégués pour la saison 2026–2027 a lieu à l’automne. Pose ta candidature, passe en entrevue et gagne ta place sur une équipe de compétition.',
    signupSoon: 'Candidatures bientôt ouvertes',
    signupFollow: 'Suis-nous sur Instagram pour ne pas manquer l’annonce :',
    mailingBody:
      'Le recrutement est fermé pour le moment. Inscris-toi à l’infolettre pour recevoir les annonces de compétitions et les candidatures du prochain cycle.',
    mailingCta: 'S’inscrire à l’infolettre',
    pathsTitle: 'Trois façons de participer',
    paths: [
      {
        heading: 'Délégué',
        body: 'Compétitionne au sein d’une équipe du JMCC. Entraîne-toi avec des coachs dédiés, voyage avec ta délégation et représente JMSB aux compétitions régionales, nationales et internationales.',
      },
      {
        heading: 'Comité exécutif',
        body: 'Fais rouler le programme derrière le Wolfpack : formation, logistique, partenariats, marketing, finance et expérience des délégués. Le recrutement des exécutifs a lieu chaque printemps.',
      },
      {
        heading: 'Coach et bénévole',
        body: 'Les diplômés et professionnels de l’industrie aiguisent nos délégués. Évalue des rondes de pratique, mentore une équipe ou coache une discipline que tu maîtrises.',
      },
    ],
    closingTitle: 'Des questions ?',
    closingCta: 'Nous joindre',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main>
    <!-- Hero (primary #1 of 2) -->
    <section class="bg-primary py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <h1 class="font-unbounded font-bold text-4xl md:text-6xl text-cream leading-tight mb-4">
          {copy.heroTitle}
        </h1>
        <p class="font-montserrat text-lg text-sand">{copy.heroSub}</p>
      </div>
    </section>

    <!-- Sign-up section — immediately below the hero (§6) -->
    <section class="bg-cream py-20 px-6 border-b border-border/15">
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <h2 class="font-unbounded font-bold text-3xl text-ink mb-5">{copy.signupTitle}</h2>
        <p class="font-montserrat text-ink/80 leading-relaxed mb-8">{copy.signupBody}</p>
        {showApply ? (
          <div class="flex flex-wrap gap-4 justify-center">
            {signupForms.map((form) => (
              <Button variant="cta" href={form.url} target="_blank" label={form.label[lang]} />
            ))}
          </div>
        ) : showMailing ? (
          <div>
            <p class="font-montserrat text-sm text-muted mb-6">{copy.mailingBody}</p>
            <Button variant="cta" href={site.mailingListUrl} target="_blank" label={copy.mailingCta} />
          </div>
        ) : (
          <div>
            <span class="inline-block border border-primary text-primary font-montserrat text-xs font-semibold uppercase tracking-widest px-4 py-2 mb-5">
              {copy.signupSoon}
            </span>
            {instagram && (
              <p class="font-montserrat text-sm text-muted">
                {copy.signupFollow}{' '}
                <a
                  href={instagram.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary font-semibold hover:text-border transition-colors"
                >
                  {instagram.handle}
                </a>
              </p>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- Three parallel path cards (§6) -->
    <section class="bg-cream py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-unbounded font-bold text-3xl text-ink text-center mb-14" data-reveal>
          {copy.pathsTitle}
        </h2>
        <div class="grid md:grid-cols-3 gap-8" data-reveal-group>
          {copy.paths.map((path) => (
            <article
              class="bg-white border border-border/20 p-8 hover:border-border/50 hover:-translate-y-0.5 transition-[border-color,transform] duration-quick"
            >
              <h3 class="font-unbounded font-bold text-lg text-primary mb-4">{path.heading}</h3>
              <p class="font-montserrat text-sm text-ink/80 leading-relaxed">{path.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing (primary #2 of 2) — split layout, text on the solid panel (no text over
         photos, §0.2). This is the page's other gold-CTA moment. -->
    <section class="bg-primary grid md:grid-cols-2">
      <div class="relative min-h-80">
        <Image
          src={photos.celebrationTrio.src}
          alt={photos.celebrationTrio.alt[lang]}
          widths={[768, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          quality={72}
          class="absolute inset-0 w-full h-full object-cover"
          style={`object-position: ${photos.celebrationTrio.focal}`}
        />
      </div>
      <div class="flex items-center px-6 md:px-14 py-20">
        <div data-reveal>
          <h2 class="font-unbounded font-bold text-2xl md:text-3xl text-cream mb-8">{copy.closingTitle}</h2>
          <Button variant="cta" href={L('/contact')} label={copy.closingCta} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
