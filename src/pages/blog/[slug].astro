---
// ABOUTME: Blog post page (EN; /fr imports this) — renders one content-collection entry.
// ABOUTME: Noindexed while site.json blogPublic is false; old /post/:slug URLs 301 here (§11).
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';
import { BLOG_CATEGORIES } from '../../data/blog-categories';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = getLangFromUrl(Astro.url);

const dateFmt = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Archived posts are English only — say so rather than implying a missing translation.
const archiveNote = {
  en: null,
  fr: 'Cet article d’archive est disponible en anglais seulement.',
}[lang];

// The cover, centre-cropped to the 1.91:1 social platforms render. Covers are portrait,
// so this takes a band out of the middle. Width is capped at the source's own width —
// Astro will not upscale, and asking for 1200 from a 1080-wide cover silently yields
// 1080×630, which is a different aspect ratio than the tags would then claim.
const CARD_WIDTH = 1200;
const CARD_RATIO = 1200 / 630;
const cardWidth = post.data.cover ? Math.min(CARD_WIDTH, post.data.cover.width) : 0;
const cardHeight = Math.round(cardWidth / CARD_RATIO);
const card = post.data.cover
  ? await getImage({
      src: post.data.cover,
      width: cardWidth,
      height: cardHeight,
      fit: 'cover',
      // Covers are 3:4 portraits of people; a centre band clips the tops of heads.
      // sharp's attention strategy picks the busiest region instead, which lands on
      // faces without needing a focal point per post.
      position: 'attention',
      format: 'jpeg',
      quality: 72,
    })
  : null;

const canonical = new URL(Astro.url.pathname, Astro.site);
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  ...(post.data.description && { description: post.data.description }),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  // Every archived post is bylined "JMCC"; a named byline would be a Person.
  author: {
    '@type': post.data.author === 'JMCC' ? 'Organization' : 'Person',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'John Molson Competition Committee',
    logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href },
  },
  ...(card && { image: new URL(card.src, Astro.site).href }),
  mainEntityOfPage: canonical.href,
};
---

<BaseLayout
  title={`${post.data.title} — JMCC`}
  description={post.data.description ?? ''}
  noIndex={!site.blogPublic}
  ogType="article"
  ogImage={card?.src}
  ogImageWidth={card ? cardWidth : undefined}
  ogImageHeight={card ? cardHeight : undefined}
  ogImageAlt={card ? (post.data.coverAlt ?? post.data.title) : undefined}
>
  <Nav />
  <main>
    <article class="bg-cream py-20 px-6">
      <div class="max-w-3xl mx-auto">
        <header class="mb-12">
          <p class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest mb-3">
            <a href={getLocalizedPath(`/blog/categories/${post.data.category}`, lang)} class="hover:text-border transition-colors">
              {BLOG_CATEGORIES[post.data.category][lang]}
            </a>
          </p>
          <h1 class="font-unbounded font-bold text-3xl md:text-4xl text-ink leading-tight mb-4">
            {post.data.title}
          </h1>
          <p class="font-montserrat text-sm text-muted">
            <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
            {post.data.readTime && <span> · {post.data.readTime}</span>}
            {post.data.author && <span> · {post.data.author}</span>}
          </p>
          {archiveNote && (
            <p class="font-montserrat text-xs text-muted italic mt-4">{archiveNote}</p>
          )}
        </header>

        {post.data.cover && (
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            widths={[640, 1024]}
            sizes="(min-width: 768px) 768px, 100vw"
            quality={72}
            class="w-full h-auto mb-12"
          />
        )}

        <div
          class="font-montserrat text-ink/85 leading-relaxed space-y-6 [&_h2]:font-unbounded [&_h2]:font-bold [&_h2]:text-2xl [&_h2]:text-ink [&_h2]:mt-10 [&_h3]:font-unbounded [&_h3]:font-bold [&_h3]:text-xl [&_h3]:text-ink [&_h3]:mt-8 [&_a]:text-primary [&_a]:underline [&_img]:max-w-full [&_img]:h-auto [&_blockquote]:border-l-2 [&_blockquote]:border-border/40 [&_blockquote]:pl-6 [&_blockquote]:italic [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-2"
        >
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
  {/* `<` escaped so a `</script>` in post frontmatter cannot close this tag early. */}
  <script type="application/ld+json" set:html={JSON.stringify(postSchema).replace(/</g, '\\u003c')} />
</BaseLayout>
