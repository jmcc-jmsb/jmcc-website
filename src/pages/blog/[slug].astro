---
// ABOUTME: Blog post page (EN; /fr imports this) — renders one content-collection entry.
// ABOUTME: Noindexed while site.json blogPublic is false; old /post/:slug URLs 301 here (§11).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl } from '../../i18n/utils';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = getLangFromUrl(Astro.url);

const dateFmt = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} — JMCC`}
  description={post.data.description ?? ''}
  noIndex={!site.blogPublic}
>
  <Nav />
  <main>
    <article class="bg-cream py-20 px-6">
      <div class="max-w-3xl mx-auto">
        <header class="mb-12">
          {post.data.category && (
            <p class="font-montserrat text-xs font-semibold text-primary uppercase tracking-widest mb-3">
              {post.data.category}
            </p>
          )}
          <h1 class="font-unbounded font-bold text-3xl md:text-4xl text-ink leading-tight mb-4">
            {post.data.title}
          </h1>
          <time class="font-montserrat text-sm text-muted">{dateFmt.format(post.data.date)}</time>
        </header>
        <div
          class="font-montserrat text-ink/85 leading-relaxed space-y-6 [&_h2]:font-unbounded [&_h2]:font-bold [&_h2]:text-2xl [&_h2]:text-ink [&_h2]:mt-10 [&_h3]:font-unbounded [&_h3]:font-bold [&_h3]:text-xl [&_h3]:text-ink [&_h3]:mt-8 [&_a]:text-primary [&_a]:underline [&_img]:max-w-full"
        >
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
