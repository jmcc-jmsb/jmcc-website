---
// ABOUTME: Base HTML shell for every page — lang, canonical, hreflang, meta, view transitions, global CSS.
// ABOUTME: Set noIndex=true for pages that should not appear in search results.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl } from '../i18n/utils';
import contact from '../data/contact.json';

interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
  /**
   * Suppresses the hreflang alternates. For the handful of routes that exist in one
   * language only — pointing at a /fr/ URL that was never built is worse than saying
   * nothing, because a crawler follows it and gets a 404.
   */
  noAlternate?: boolean;
  /** Absolute or root-relative image for social cards; defaults to the brand card. */
  ogImage?: string;
  /**
   * Real pixel size of ogImage. Scrapers render the card before the image finishes
   * downloading, so a wrong number here shows the wrong crop — pass the emitted
   * dimensions whenever ogImage is overridden, don't assume the default.
   */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Describes the card image for screen readers on social platforms. */
  ogImageAlt?: string;
  /** Overrides og:type — posts should pass "article". */
  ogType?: string;
}

const {
  title,
  description = '',
  noIndex = false,
  noAlternate = false,
  ogImage = '/og-default.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt ='JMCC — We Compete. The world\'s largest case competition program.',
  ogType = 'website',
} = Astro.props;
const lang = getLangFromUrl(Astro.url);

const enPath =
  lang === 'fr' ? Astro.url.pathname.replace(/^\/fr/, '') || '/' : Astro.url.pathname;
const frPath =
  lang === 'en' ? `/fr${Astro.url.pathname}` : Astro.url.pathname;

// Every absolute URL derives from astro.config.mjs `site`. Never hardcode a hostname.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// Organization data for the homepage only — repeating it on every page is noise.
const isHome = enPath === '/';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'John Molson Competition Committee',
  alternateName: 'JMCC',
  url: Astro.site?.href,
  // The shield itself, not the social card — search engines expect the mark here, and
  // og-default.png is a 1200×630 banner with headline copy baked in.
  logo: new URL('/logo.png', Astro.site).href,
  description:
    "The world's largest case competition program. JMSB delegates compete at business case competitions across Canada and around the globe.",
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.line1,
    addressLocality: contact.address.city,
    addressRegion: contact.address.province,
    postalCode: contact.address.postalCode,
    addressCountry: 'CA',
  },
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'John Molson School of Business, Concordia University',
  },
  sameAs: contact.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {!noAlternate && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
        <link rel="alternate" hreflang="fr" href={new URL(frPath, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
      </>
    )}

    <meta property="og:site_name" content="JMCC — John Molson Competition Committee" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_CA' : 'fr_CA'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* `<` is escaped because neither JSON.stringify nor set:html escapes it: a `</script>`
        inside any schema value would close this tag early. Every value here is
        repo-authored today, so this is a guard against that stopping being true. */}
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema).replace(/</g, '\\u003c')} />
    )}
    <ClientRouter />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!-- Nav-condense trigger. Absolute with no positioned ancestor, so it anchors to
         the document origin and scrolls away with the page — zero layout footprint.
         Lets the nav react to scroll position without a scroll listener. -->
    <div id="nav-sentinel" class="pointer-events-none absolute top-0 left-0 h-30 w-px" aria-hidden="true"></div>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
