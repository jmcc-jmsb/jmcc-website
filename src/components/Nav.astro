---
// ABOUTME: Sticky top nav — dropdown groups, gold Donate CTA, EN/FR toggle, accessible mobile menu.
// ABOUTME: Blog link appears only when site.json blogPublic is true (see MAINTENANCE.md).
import { Image } from 'astro:assets';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import shieldColor from '../assets/brand/jmcc-shield-color.png';
import site from '../data/site.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const alternateLang = lang === 'en' ? 'fr' : 'en';
const alternatePath =
  lang === 'fr'
    ? Astro.url.pathname.replace(/^\/fr/, '') || '/'
    : `/fr${Astro.url.pathname}`;

interface NavItem {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

const navItems: NavItem[] = [
  {
    label: t('nav.who-we-are'),
    href: '/who-we-are',
    children: [
      { label: t('nav.our-team'), href: '/team' },
      { label: t('nav.sponsors'), href: '/sponsors' },
    ],
  },
  {
    label: t('nav.competitions'),
    href: '/competitions',
    children: [
      { label: t('nav.all-competitions'), href: '/competitions' },
      { label: t('nav.disciplines'), href: '/disciplines' },
    ],
  },
  { label: t('nav.get-involved'), href: '/get-involved' },
  { label: t('nav.portal'), href: '/portal' },
  {
    label: t('nav.contact'),
    href: '/contact',
    children: [
      { label: t('nav.contact-us'), href: '/contact' },
      { label: t('nav.report'), href: '/report' },
    ],
  },
  ...(site.blogPublic ? [{ label: t('nav.blog'), href: '/blog' }] : []),
];

// Flat list for the mobile menu — parents followed by their children.
const mobileItems = navItems.flatMap((item) =>
  item.children ? [item, ...item.children.filter((c) => c.href !== item.href)] : [item],
);

const isActive = (href: string) => {
  const lhref = getLocalizedPath(href, lang);
  return currentPath === lhref || currentPath.startsWith(`${lhref}/`);
};
---

<header class="bg-primary sticky top-0 z-50 shadow-sm">
  <!-- max-w-[96rem] rather than 7xl: uses the horizontal space on wide screens
       (phase-2b §14); mobile layout is untouched (hamburger below lg). -->
  <nav
    class="max-w-[96rem] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a
      href={getLocalizedPath('/', lang)}
      class="nav-logo flex items-center gap-2 shrink-0"
      aria-label="JMCC — Home"
    >
      <Image
        src={shieldColor}
        alt=""
        width={36}
        height={36}
        class="w-9 h-9 object-contain"
      />
      <span class="font-unbounded font-bold text-cream text-xs tracking-widest hidden sm:block">
        JMCC
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden lg:flex items-center gap-6 xl:gap-9 flex-1 justify-center" role="list">
      {navItems.map((item) => {
        const active =
          isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
        return (
          <li class="relative group">
            <a
              href={getLocalizedPath(item.href, lang)}
              class:list={[
                'link-sweep font-montserrat text-xs font-semibold uppercase tracking-wide transition-colors duration-quick inline-flex items-center gap-1 py-2',
                active ? 'text-gold' : 'text-cream/80 hover:text-cream',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" />
                </svg>
              )}
            </a>
            {item.children && (
              <ul
                class="absolute left-0 top-full hidden group-hover:block group-focus-within:block bg-primary border border-cream/15 shadow-lg min-w-44 py-2"
                role="list"
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={getLocalizedPath(child.href, lang)}
                      class:list={[
                        'block px-4 py-2 font-montserrat text-xs font-semibold uppercase tracking-wide transition-colors duration-quick whitespace-nowrap',
                        isActive(child.href) ? 'text-gold' : 'text-cream/80 hover:text-cream',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>

    <!-- Donate CTA + lang toggle + hamburger -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        href={getLocalizedPath('/donate', lang)}
        class="hidden sm:inline-flex bg-gold text-ink px-4 py-2 font-montserrat text-xs font-bold uppercase tracking-widest hover:bg-sand transition-colors duration-quick"
      >
        {t('nav.donate')}
      </a>
      <a
        href={alternatePath}
        lang={alternateLang}
        class="link-sweep font-montserrat text-xs font-semibold text-cream/60 hover:text-cream uppercase tracking-widest transition-colors duration-quick"
      >
        {t('nav.lang-toggle')}
      </a>
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-cream p-1 -mr-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path id="icon-open"  stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          <path id="icon-close" stroke-linecap="round" d="M6 18L18 6M6 6l12 12" class="hidden" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-cream/15 px-6 pb-5 pt-3"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <ul role="list" class="flex flex-col gap-1">
      {mobileItems.map((item) => (
        <li>
          <a
            href={getLocalizedPath(item.href, lang)}
            class="block py-2 font-montserrat text-sm text-cream/80 hover:text-cream transition-colors duration-quick"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a
          href={getLocalizedPath('/donate', lang)}
          class="inline-flex bg-gold text-ink px-4 py-2 font-montserrat text-xs font-bold uppercase tracking-widest hover:bg-sand transition-colors duration-quick"
        >
          {t('nav.donate')}
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  /* Sticky nav condense (motion-layer.md §Sticky nav condense). Driven by
     #nav-sentinel in BaseLayout via IntersectionObserver — no scroll listener.

     The bar height is deliberately constant. A sticky element still occupies its
     slot in flow, so animating its height shifts every pixel of the page below it
     while the visitor is mid-scroll, and height is not compositor-safe either way.
     The logo scaling down and the rule appearing carry the same signal for free. */
  .nav-logo {
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-soft);
  }
  header.is-condensed .nav-logo {
    transform: scale(0.86);
  }

  header::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background-color: var(--color-border);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-soft);
    pointer-events: none;
  }
  header.is-condensed::after {
    opacity: 1;
  }
</style>

<script>
  function initNav() {
    const btn  = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const open  = document.getElementById('icon-open');
    const close = document.getElementById('icon-close');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    btn.addEventListener('click', () => {
      const isOpen = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      open?.classList.toggle('hidden', isOpen);
      close?.classList.toggle('hidden', !isOpen);
    });
  }
  document.addEventListener('astro:page-load', initNav);
</script>
