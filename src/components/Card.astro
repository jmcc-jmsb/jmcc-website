---
// ABOUTME: Base card for blog posts, competitions, and team member grids.
// ABOUTME: Accepts optional image, tag, date, description, and a read-more link.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ClawFlick from './ClawFlick.astro';

interface Props {
  title: string;
  description?: string;
  href?: string;
  image?: ImageMetadata;
  alt?: string;
  tag?: string;
  date?: string;
  readMoreLabel?: string;
}

const {
  title,
  description,
  href,
  image,
  alt = '',
  tag,
  date,
  readMoreLabel = 'Read more',
} = Astro.props;
---

<article class="relative bg-cream border border-border/20 overflow-hidden group flex flex-col">
  <ClawFlick />
  {image && (
    <a href={href} class="block overflow-hidden aspect-video shrink-0">
      <Image
        src={image}
        alt={alt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-base"
      />
    </a>
  )}
  <div class="p-6 flex flex-col flex-1">
    {(tag || date) && (
      <div class="flex items-center gap-3 mb-3">
        {tag && <span class="text-xs font-montserrat font-semibold uppercase tracking-widest text-primary">{tag}</span>}
        {tag && date && <span class="text-muted" aria-hidden="true">·</span>}
        {date && <time class="text-xs font-montserrat text-muted">{date}</time>}
      </div>
    )}
    <h3 class="font-unbounded font-bold text-base text-ink mb-2 leading-snug">
      {href
        ? <a href={href} class="hover:text-primary transition-colors duration-quick">{title}</a>
        : title
      }
    </h3>
    {description && (
      <p class="font-montserrat text-sm text-ink/70 leading-relaxed mb-4 flex-1">{description}</p>
    )}
    {href && (
      <a
        href={href}
        class="mt-auto font-montserrat text-xs font-semibold text-primary uppercase tracking-widest hover:text-border transition-colors duration-quick"
        aria-label={`${readMoreLabel}: ${title}`}
      >
        {readMoreLabel} →
      </a>
    )}
  </div>
</article>
