---
// ABOUTME: Responsive logo grid for sponsors or competition partners.
// ABOUTME: Grayscale by default, full color on hover; logos link out if href provided.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Logo {
  src: ImageMetadata;
  alt: string;
  href?: string;
}

interface Props {
  logos: Logo[];
  title?: string;
}

const { logos, title } = Astro.props;
---

<section class="py-16 px-6 bg-cream">
  {title && (
    <h2 class="font-unbounded font-bold text-xl text-ink text-center uppercase tracking-wide mb-10">
      {title}
    </h2>
  )}
  <ul
    class="max-w-5xl mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-8 items-center justify-items-center list-none p-0"
    role="list"
  >
    {logos.map(({ src, alt, href }) => (
      <li>
        {href ? (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="block opacity-60 hover:opacity-100 transition-opacity duration-200"
          >
            <Image
              src={src}
              alt={alt}
              class="max-h-14 w-auto object-contain grayscale hover:grayscale-0 transition-all duration-300"
            />
          </a>
        ) : (
          <Image
            src={src}
            alt={alt}
            class="max-h-14 w-auto object-contain opacity-60 grayscale"
          />
        )}
      </li>
    ))}
  </ul>
</section>
