---
// ABOUTME: Section divider — the three claw gashes draw themselves on entry, staggered.
// ABOUTME: aria-hidden; purely visual. Use max 1–2 per page per brand guidelines.
import { clawDrawSvg as claw } from '../lib/claw';

// 410:608 portrait, rotated 90° to read as a horizontal slash across the strip.
// 144px wide before rotation → 214px tall, which is 214×144 once turned.
---

<div
  class="relative h-40 overflow-hidden bg-sand/10 flex items-center justify-center"
  aria-hidden="true"
>
  <div
    class="claw-draw w-36 h-[214px] rotate-90 text-border"
    data-reveal="draw"
    set:html={claw}
  />
</div>
