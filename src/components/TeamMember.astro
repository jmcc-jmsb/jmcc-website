---
// ABOUTME: Team member card — uniform 4:5 headshot (branded initials fallback), name, role, LinkedIn.
// ABOUTME: LinkedIn-only by decision: exec emails are never rendered; cards stay clean with linkedin:null.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SocialIcon from './SocialIcon.astro';

interface Props {
  name: string;
  role: string;
  linkedin?: string | null;
  photo?: ImageMetadata | null;
  focal?: string;
  alt?: string;
  size?: 'standard' | 'large';
}

const { name, role, linkedin, photo, focal = 'center', alt, size = 'standard' } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const hasLinkedin = Boolean(linkedin && !linkedin.startsWith('TODO'));
// py-1.5 lifts the tap target to ~24px tall, the WCAG 2.5.8 minimum — the label
// alone is 12px, which is a fiddly thing to hit on a phone.
const linkCls =
  'inline-flex items-center gap-1.5 py-1.5 font-montserrat text-xs font-semibold text-primary hover:text-border uppercase tracking-widest transition-colors';
const isLarge = size === 'large';
const photoWidths = isLarge ? [280, 560] : [260, 520];
const photoSizes = isLarge ? '280px' : '260px';
---

<article class:list={['group text-center w-full mx-auto', isLarge ? 'max-w-[280px]' : 'max-w-[260px]']} data-reveal>
  <div class="aspect-4/5 overflow-hidden border border-border/20 mb-4">
    {photo ? (
      <Image
        src={photo}
        alt={alt ?? `${name} — ${role}`}
        widths={photoWidths}
        sizes={photoSizes}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-base"
        style={`object-position: ${focal}`}
      />
    ) : (
      <div
        class="w-full h-full bg-primary flex items-center justify-center"
        role="img"
        aria-label={alt ?? `${name} — ${role}`}
      >
        <span class:list={['font-unbounded font-bold text-gold', isLarge ? 'text-5xl' : 'text-4xl']} aria-hidden="true">{initials}</span>
      </div>
    )}
  </div>
  <h3 class:list={['font-unbounded font-bold text-ink leading-snug', isLarge ? 'text-base' : 'text-sm']}>{name}</h3>
  <p class="font-montserrat text-sm text-muted mt-1">{role}</p>
  {/* No mailto here, ever — exec emails stay in the data schema but are never rendered
      (team.json _no_email). linkedin:null renders no icon, no dash, no layout shift. */}
  {hasLinkedin && (
    <div class="mt-2 flex justify-center">
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class={linkCls} aria-label={`LinkedIn — ${name}`}>
        {/* aria-hidden inside SocialIcon — the link's aria-label already names it. */}
        <SocialIcon platform="linkedin" class="w-3.5 h-3.5" />
        LinkedIn
      </a>
    </div>
  )}
</article>
