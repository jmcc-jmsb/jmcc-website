---
// ABOUTME: Team member card — photo (circular), name, role, optional LinkedIn.
// ABOUTME: Alt text defaults to "Name — Role" if not provided; always supply meaningful alt.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo: ImageMetadata;
  name: string;
  role: string;
  linkedin?: string;
  alt?: string;
}

const { photo, name, role, linkedin, alt } = Astro.props;
---

<article class="group text-center">
  <div class="overflow-hidden rounded-full w-32 h-32 mx-auto mb-4 border-2 border-border/40">
    <Image
      src={photo}
      alt={alt ?? `${name} — ${role}`}
      width={128}
      height={128}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
  </div>
  <h3 class="font-unbounded font-bold text-sm text-ink uppercase tracking-wide leading-snug">{name}</h3>
  <p class="font-montserrat text-sm text-muted mt-1">{role}</p>
  {linkedin && (
    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-2 font-montserrat text-xs font-semibold text-primary hover:text-border uppercase tracking-widest transition-colors"
      aria-label={`LinkedIn — ${name}`}
    >
      LinkedIn →
    </a>
  )}
</article>
