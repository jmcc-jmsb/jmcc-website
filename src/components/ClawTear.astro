---
// ABOUTME: Claw tear — the incoming section is clipped by three gashes that widen on scroll.
// ABOUTME: The one signature moment; budget is one per page, two on Home. Wrap the section in it.
import { clawGashes, CLAW_TO_UNIT_BOX } from '../lib/claw';
import SectionDivider from './SectionDivider.astro';

interface Props {
  /** Which way the gashes widen. */
  direction?: 'down' | 'up';
  /** `heavy` opens wider and strokes a thicker edge; `light` is the secondary treatment. */
  weight?: 'heavy' | 'light';
  /**
   * Fraction of the viewport to delay the start by. 0 begins the moment the
   * boundary crosses the bottom edge; 0.2 waits until it is a fifth of the way up.
   * The tear always completes by the viewport centre regardless, so content is
   * never left unreadable if someone stops scrolling.
   */
  triggerOffset?: number;
  /** Extra classes for the wrapper. */
  class?: string;
}

const {
  direction = 'down',
  weight = 'heavy',
  triggerOffset = 0,
  class: className = '',
} = Astro.props;

// Unique per instance so several tears can coexist on one page.
const clipId = `claw-tear-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['claw-tear', `claw-tear--${weight}`, `claw-tear--${direction}`, className]}
  data-tear
  data-trigger-offset={triggerOffset}
  style={`--tear-clip: url(#${clipId})`}
>
  {/* Carries the clip definition only — zero-sized, paints nothing. */}
  <svg class="claw-tear__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={clipId} clipPathUnits="objectBoundingBox">
        <g transform={CLAW_TO_UNIT_BOX} set:html={clawGashes} />
      </clipPath>
    </defs>
  </svg>

  <div class="claw-tear__content">
    <slot />
  </div>

  {/* The sand edge. Same paths, same scale, stroked rather than clipped — a clipPath
      cannot carry a stroke, so the edge has to be a second copy painted on top.
      preserveAspectRatio="none" keeps its 0–1 space aligned with the clip's. */}
  <svg
    class="claw-tear__edge"
    viewBox="0 0 1 1"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <g transform={CLAW_TO_UNIT_BOX} set:html={clawGashes} />
  </svg>

  {/* Reduced motion gets a deliberate alternative, not a degraded one: the section
      renders unclipped and this static scratch divider marks the boundary instead. */}
  <div class="claw-tear__static"><SectionDivider /></div>
</div>
